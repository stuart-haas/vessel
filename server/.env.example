# Copy to .env and adjust. All variables are prefixed with VESSEL_.

# scripture.api.bible API key (https://scripture.api.bible)
VESSEL_BIBLE_API_KEY=2c3fac5f2c049f578953ef5bdd7e6c69
VESSEL_DEFAULT_BIBLE_ID=de4e12af7f2817c0-01

# Persistence (SQLite by default; swap for e.g. postgresql://user:pass@host/db)
VESSEL_DATABASE_URL=sqlite:///./vessel.db

# CORS: comma-separated origins, or * for all
VESSEL_CORS_ORIGINS=*
